  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz()

  user UserIdentity @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, studio_id, branch_id])
  @@index([user_id])
  @@index([studio_id])
  @@index([user_id, studio_id])
  @@map("user_roles")
}

model StaffInvitation {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id            String    @db.Uuid
  staff_id             String    @db.Uuid
  email                String
  token                String    @unique
  role_name            String
  branch_id            String?   @db.Uuid
  permission_overrides Json      @default("{}")
  status               String    @default("pending") // pending | accepted | revoked | expired
  invited_by           String    @db.Uuid
  expires_at           DateTime  @db.Timestamptz()
  accepted_at          DateTime? @db.Timestamptz()
  created_at           DateTime  @default(now()) @db.Timestamptz()

  @@index([studio_id])
  @@index([staff_id])
  @@index([token])
  @@map("staff_invitations")
}

model UserDashboardLayout {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  studio_id   String   @db.Uuid
  role        String
  layout_json Json
  version     Int      @default(1)
  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@unique([user_id, studio_id, role])
  @@index([user_id, studio_id])
  @@map("user_dashboard_layouts")
}

model Referral {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrer_studio_id String    @db.Uuid
  referred_studio_id String    @unique @db.Uuid // a studio can only be referred once
  referral_code      String // immutable snapshot of the code used
  referred_email     String?
  campaign_id        String?   @db.Uuid // optional time-bounded campaign attribution
  status             String    @default("pending") // see lifecycle above
  risk_score         Int       @default(0) // 0–100; computed by fraud engine
  rewarded_at        DateTime? @db.Timestamptz()
  reversed_at        DateTime? @db.Timestamptz()
  reversed_reason    String?
  idempotency_key    String?   @unique // set once reward processing begins
  metadata           Json      @default("{}") // utm, device, ip, etc.
  created_at         DateTime  @default(now()) @db.Timestamptz()
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz()

  referrer_studio Studio                   @relation("ReferrerStudio", fields: [referrer_studio_id], references: [id])
  referred_studio Studio                   @relation("ReferredStudio", fields: [referred_studio_id], references: [id])
  campaign        ReferralCampaign?        @relation(fields: [campaign_id], references: [id])
  reward_logs     RewardLog[]
  lifecycle       ReferralLifecycleEvent[]
  fraud_signals   ReferralFraudSignal[]

  @@index([referrer_studio_id])
  @@index([status])
  @@index([referral_code])
  @@index([campaign_id])
  @@map("referrals")
}

model ReferralRewardRule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String?
  // 'b2b_subscription_activated' | 'b2b_subscription_renewed' | 'b2b_yearly_upgrade' | ...
  trigger_event String    @default("b2b_subscription_activated")
  campaign_id   String?   @db.Uuid
  conditions    Json      @default("{}")
  rewards       Json      @default("[]")
  priority      Int       @default(0)
  is_active     Boolean   @default(true)
  max_uses      Int?
  uses_count    Int       @default(0)
  valid_from    DateTime? @db.Timestamptz()
  valid_until   DateTime? @db.Timestamptz()
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz()

  campaign    ReferralCampaign? @relation(fields: [campaign_id], references: [id])
  reward_logs RewardLog[]

  @@index([is_active, trigger_event])
  @@index([priority])
  @@index([campaign_id])
  @@map("referral_reward_rules")
}

model RewardLog {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referral_id                String    @db.Uuid
  rule_id                    String    @db.Uuid
  beneficiary_studio_id      String    @db.Uuid
  event_type                 String // 'subscription_activated' | 'subscription_renewed' | ...
  event_payload              Json // full payload snapshot at award time
  reward_type                String // 'extend_subscription' | 'account_credit' | 'trial_extension' | 'wallet_credit'
  reward_value               Json // shape depends on reward_type
  idempotency_key            String    @unique
  status                     String    @default("applied") // applied | failed | reversed
  failure_reason             String?
  // Snapshot of subscription extension for audit
  subscription_extended_from DateTime? @db.Timestamptz()
  subscription_extended_to   DateTime? @db.Timestamptz()
  applied_at                 DateTime  @default(now()) @db.Timestamptz()
  reversed_at                DateTime? @db.Timestamptz()
  reversed_reason            String?

  referral    Referral           @relation(fields: [referral_id], references: [id])
  rule        ReferralRewardRule @relation(fields: [rule_id], references: [id])
  beneficiary Studio             @relation("RewardBeneficiary", fields: [beneficiary_studio_id], references: [id])

  @@index([beneficiary_studio_id, status])
  @@index([referral_id])
  @@index([applied_at])
  @@map("reward_logs")
}

model ReferralLifecycleEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referral_id String   @db.Uuid
  from_status String?
  to_status   String
  actor_type  String   @default("system") // system | admin | webhook | gym_owner
  actor_id    String?  @db.Uuid
  payload     Json     @default("{}")
  occurred_at DateTime @default(now()) @db.Timestamptz()

  referral Referral @relation(fields: [referral_id], references: [id])

  @@index([referral_id, occurred_at])
  @@map("referral_lifecycle_events")
}

model ReferralFraudSignal {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referral_id       String?   @db.Uuid // null = signal not yet bound to a referral
  subject_studio_id String?   @db.Uuid // either subject studio
  signal_type       String // 'duplicate_phone' | 'duplicate_gst' | 'duplicate_ip' | 'self_referral' | 'velocity' | 'device_fingerprint'
  severity          String    @default("low") // low | medium | high | critical
  evidence          Json      @default("{}") // raw matching data
  review_status     String    @default("pending") // pending | reviewed_ok | confirmed_fraud
  reviewed_by       String?   @db.Uuid
  reviewed_at       DateTime? @db.Timestamptz()
  reviewer_notes    String?
  created_at        DateTime  @default(now()) @db.Timestamptz()

  referral Referral? @relation(fields: [referral_id], references: [id])
  subject  Studio?   @relation("FraudSubjectStudio", fields: [subject_studio_id], references: [id])

  @@index([review_status, severity])
  @@index([subject_studio_id])
  @@map("referral_fraud_signals")
}

model ReferralWallet {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id  String   @unique @db.Uuid
  currency   String   @default("INR")
  // Cached balance — recomputed by trigger / app code from entries.
  // Authoritative source is the SUM of entries.
  balance    Decimal  @default(0) @db.Decimal(14, 2)
  status     String   @default("active") // active | frozen
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  studio  Studio                @relation(fields: [studio_id], references: [id])
  entries ReferralWalletEntry[]

  @@map("referral_wallets")
}

model ReferralWalletEntry {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id         String    @db.Uuid
  entry_type        String // 'credit' | 'debit' | 'reversal' | 'expiry'
  amount            Decimal   @db.Decimal(14, 2) // signed
  currency          String    @default("INR")
  source_type       String // 'referral_reward' | 'manual_adjustment' | 'subscription_payment' | 'addon_purchase' | 'expiry'
  source_id         String?   @db.Uuid // FK target depends on source_type
  reward_log_id     String?   @db.Uuid
  reverses_entry_id String?   @db.Uuid
  idempotency_key   String    @unique
  expires_at        DateTime? @db.Timestamptz() // credits can expire
  description       String?
  metadata          Json      @default("{}")
  created_at        DateTime  @default(now()) @db.Timestamptz()

  wallet ReferralWallet @relation(fields: [wallet_id], references: [id])

  @@index([wallet_id, created_at])
  @@index([source_type, source_id])
  @@map("referral_wallet_entries")
}

model ReferralCampaign {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  scope          String    @default("global") // global | region | plan
  scope_filters  Json      @default("{}") // { regions: [...], plan_ids: [...] }
  rule_overrides Json      @default("[]") // RewardAction[] to apply on top of base rules
  valid_from     DateTime? @db.Timestamptz()
  valid_until    DateTime? @db.Timestamptz()
  is_active      Boolean   @default(true)
  max_total_uses Int?
  uses_count     Int       @default(0)
  created_by     String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz()
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz()

  referrals Referral[]
  rules     ReferralRewardRule[]

  @@index([is_active, valid_from, valid_until])
  @@map("referral_campaigns")
}

model DeviceIndex {
  device_id   String   @id @db.Uuid
  gym_id      String   @db.Uuid
  schema_name String
  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@map("device_index")
}

model BiometricDeviceIndex {
  device_sn   String   @id
  gym_id      String   @db.Uuid
  schema_name String
  branch_id   String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@map("biometric_device_index")
}

model WhatsAppNumberIndex {
  phone_number_id String   @id
  gym_id          String   @db.Uuid
  schema_name     String
  created_at      DateTime @default(now()) @db.Timestamptz()
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@map("whatsapp_number_index")
}

/// Immutable snapshot of a shared routine, keyed by an unguessable token.
/// Carries exercise NAMES, never ids: ids are gym-scoped and gyms hold
/// different catalogues, so names are the only portable key. Holds no member
/// id, gym id or gym name — a share link reveals a workout, never who wrote it
/// or where they train.
model SharedRoutine {
  token        String   @id
  name         String
  exercises    Json
  created_at   DateTime @default(now()) @db.Timestamptz()
  import_count Int      @default(0)

  /// Deliveries of this snapshot to specific friends. A routine can be sent to
  /// several people from one token, so the snapshot is stored once.
  friend_shares FriendRoutineShare[]

  @@map("shared_routines")
}

/// Central, MuscleX-curated workout library. Content, not tenant state: no
/// member or gym data lives here. Exercises are NAMES, because ids are
/// gym-scoped and gyms hold different catalogues.
model ExploreWorkout {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String   @unique
  title            String
  description      String?
  category         String
  difficulty       String   @default("beginner")
  duration_minutes Int?
  exercises        Json
  is_published     Boolean  @default(false)
  position         Int      @default(0)
  add_count        Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz()
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@index([category, position])
  @@map("explore_workouts")
}

/// ─── FRIENDS ────────────────────────────────────────────────────────────────
/// Everything below lives in `public` on purpose. A friend is usually at ANOTHER
/// gym, and their workouts live in that gym's schema — reading it would be a
/// cross-tenant read. Instead each member publishes the summary they opted into
/// sharing, and friends read only from here. See the 20260820_friends migration.

model Friendship {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_id String    @db.Uuid
  addressee_id String    @db.Uuid
  /// 'pending' | 'accepted' | 'blocked'. Only 'accepted' grants any read.
  status       String    @default("pending")
  created_at   DateTime  @default(now()) @db.Timestamptz()
  responded_at DateTime? @db.Timestamptz()

  requester AppUser @relation("FriendshipRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee AppUser @relation("FriendshipAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)

  @@index([requester_id, status])
  @@index([addressee_id, status])
  @@map("friendships")
}

/// A published workout summary. Pruned to 90 days by the publisher on write, so
/// this table stays bounded instead of growing with every session ever logged.
model AppUserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  app_user_id      String   @db.Uuid
  /// The tenant workout_logs id, so re-publishing updates instead of duplicating.
  /// NOT for joining back into the gym schema — avoiding that is the point.
  source_log_id    String?  @db.Uuid
  performed_at     DateTime @db.Timestamptz()
  title            String?
  exercise_count   Int      @default(0)
  set_count        Int      @default(0)
  total_volume_kg  Decimal? @db.Decimal(10, 2)
  duration_seconds Int?
  exercise_names   Json     @default("[]")
  kudos_count      Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz()

  app_user AppUser       @relation(fields: [app_user_id], references: [id], onDelete: Cascade)
  kudos    SessionKudos[]

  @@index([app_user_id, performed_at])
  @@map("app_user_sessions")
}

/// Best lift per exercise NAME. Name, not id: exercise ids are gym-scoped, so an
/// id means nothing across the boundary this table exists to cross.
model AppUserPr {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  app_user_id   String   @db.Uuid
  /// Stored lowercased so comparison is equality, not a function scan.
  exercise_name String
  weight_kg     Decimal  @db.Decimal(6, 2)
  reps          Int
  achieved_at   DateTime @db.Timestamptz()
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz()

  app_user AppUser @relation(fields: [app_user_id], references: [id], onDelete: Cascade)

  @@unique([app_user_id, exercise_name])
  @@map("app_user_prs")
}

model SessionKudos {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id  String   @db.Uuid
  app_user_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz()

  session  AppUserSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  app_user AppUser        @relation(fields: [app_user_id], references: [id], onDelete: Cascade)

  @@unique([session_id, app_user_id])
  @@map("session_kudos")
}

/// Delivery record for a routine sent to a friend. The routine itself is an
/// existing shared_routines snapshot, so the receiver's import path is the one
/// already proven by share links.
model FriendRoutineShare {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_app_user_id String    @db.Uuid
  to_app_user_id   String    @db.Uuid
  token            String
  routine_name     String
  created_at       DateTime  @default(now()) @db.Timestamptz()
  imported_at      DateTime? @db.Timestamptz()

  from_app_user AppUser       @relation("RoutineShareFrom", fields: [from_app_user_id], references: [id], onDelete: Cascade)
  to_app_user   AppUser       @relation("RoutineShareTo", fields: [to_app_user_id], references: [id], onDelete: Cascade)
  routine       SharedRoutine @relation(fields: [token], references: [token], onDelete: Cascade)

  @@index([to_app_user_id, created_at])
  @@map("friend_routine_shares")
}

/// A workout of any sport, owned by the PERSON not the gym.
///
/// A run in a park has no studio, and a member who changes gyms must not lose
/// their history — so this lives in `public` beside friendships and health
/// rollups, and never enters the tenant model set.
model AppUserActivity {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  app_user_id      String   @db.Uuid

  /// One of SPORT_TYPES. Text, not a pg enum: new sports get added often and
  /// ALTER TYPE ... ADD VALUE cannot run inside a transaction.
  sport_type       String
  title            String?
  description      String?
  /// gps | manual | import | device
  source           String   @default("manual")

  started_at       DateTime @db.Timestamptz()
  ended_at         DateTime? @db.Timestamptz()
  /// Wall clock. `moving_seconds` excludes auto-paused time.
  elapsed_seconds  Int      @default(0)
  moving_seconds   Int?

  distance_m       Decimal? @db.Decimal(10, 2)
  elevation_gain_m Decimal? @db.Decimal(8, 2)
  elevation_loss_m Decimal? @db.Decimal(8, 2)
  avg_speed_mps    Decimal? @db.Decimal(6, 3)
  max_speed_mps    Decimal? @db.Decimal(6, 3)

  avg_heart_rate   Int?
  max_heart_rate   Int?
  calories         Int?

  /// Simplified encoded polyline for map previews only. The full track lives in
  /// the streams, so a feed of twenty cards does not load twenty rides.
  polyline         String?
  start_latitude   Decimal? @db.Decimal(10, 7)
  start_longitude  Decimal? @db.Decimal(10, 7)

  /// everyone | followers | only_me. Defaults to followers: a GPS trace shows
  /// where someone lives and when they are out.
  visibility       String   @default("followers")
  privacy_zone_m   Int?

  kudos_count      Int      @default(0)
  comment_count    Int      @default(0)

  created_at       DateTime @default(now()) @db.Timestamptz()
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz()

  app_user AppUser                   @relation(fields: [app_user_id], references: [id], onDelete: Cascade)
  streams  AppUserActivityStream[]
  laps     AppUserActivityLap[]
  photos   AppUserActivityPhoto[]

  @@index([app_user_id, started_at])
  @@index([app_user_id, sport_type, started_at])
  @@map("app_user_activities")
}

/// One whole time series as a single JSON array.
///
/// Row-per-point would be ~70,000 rows for one three-hour ride across all
/// streams, for data that is only ever read whole to draw a chart.
model AppUserActivityStream {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id String   @db.Uuid
  /// latlng | time | distance | altitude | heartrate | cadence | velocity |
  /// watts | temperature | moving
  type        String
  data        Json     @default("[]")
  point_count Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz()

  activity AppUserActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([activity_id, type])
  @@map("app_user_activity_streams")
}

model AppUserActivityLap {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id     String   @db.Uuid
  lap_index       Int
  elapsed_seconds Int      @default(0)
  moving_seconds  Int?
  distance_m      Decimal? @db.Decimal(10, 2)
  avg_heart_rate  Int?
  max_heart_rate  Int?
  /// Offsets into the streams, so a lap highlights on the chart without
  /// storing its points twice.
  start_index     Int?
  end_index       Int?
  created_at      DateTime @default(now()) @db.Timestamptz()

  activity AppUserActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([activity_id, lap_index])
  @@map("app_user_activity_laps")
}

model AppUserActivityPhoto {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id  String   @db.Uuid
  /// Path in the private bucket; served as a signed URL, never public.
  storage_path String
  is_primary   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz()

  activity AppUserActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@index([activity_id])
  @@map("app_user_activity_photos")
}
