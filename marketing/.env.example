# ─── Public (inlined into the browser bundle) ───────────────────────────────

# Where the gym admin app lives. Every product CTA is built from this:
# "Start free" → /register, "Log in" → /login.
NEXT_PUBLIC_APP_URL="https://app.musclex.infynarc.com"

# Public origin of this marketing site. Used for canonical URLs, Open Graph and
# sitemap.xml. Set this in production or search engines get localhost URLs.
NEXT_PUBLIC_SITE_URL="https://musclex.infynarc.com"


# ─── Server-only (NEVER prefix these with NEXT_PUBLIC_) ─────────────────────
# Used by src/app/api/contact/route.ts to forward contact-form submissions into
# the SaaS Control Center, where they appear under "Gym Owner Leads".
#
# The browser posts to this app's own /api/contact; only this server process
# talks to the SCC. That keeps the control plane off the public internet and
# means no CORS entry is needed for the marketing domain.

# The SCC API base URL, including its /api/v1 prefix. Used for BOTH:
#   - forwarding contact-form enquiries  (POST /gym-owner-leads/ingest)
#   - reading the live plan catalogue    (GET  /plans/marketing)
# Without it, pricing falls back to the built-in catalogue in src/lib/plans.ts.
# NOTE the host: the SCC *API* is `scc-api.`, not `scc.` (which is the SCC
# front-end origin and resolves to nothing today). Pointing this at `scc.`
# fails silently — contact submissions stop reaching the SCC and pricing
# quietly falls back to the built-in catalogue, with no visible error.
SCC_API_URL="https://scc-api.musclex.infynarc.com/api/v1"

# Must match MARKETING_INGEST_SECRET on the SCC API exactly.
# Generate with: openssl rand -hex 32
MARKETING_INGEST_SECRET=""
