# Staff API base. The backend must be running on this port.
# frontend/.env.local points at 4002 locally; .env.example there says 4000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4002/api/v1

# Dev-only sign-in prefill. Populate from backend/scripts/seed-staff-app-test.ts.
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
