{
  "expo": {
    "name": "MuscleX Staff",
    "slug": "musclex-staff",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F7",
    "scheme": "musclex-staff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infynarc.musclex.staff",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.infynarc.musclex.staff",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
