{
  "expo": {
    "name": "MuscleX Staff",
    "slug": "musclex-staff",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F7",
    "scheme": "musclex-staff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infynarc.musclex.staff",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.infynarc.musclex.staff",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "MuscleX uses the camera to scan member QR codes at check-in.",
          "recordAudioAndroid": false
        }
      ],
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ad80e82-7758-4bb2-bfd4-a8c2cd175348"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png"
  }
}
